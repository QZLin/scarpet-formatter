{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "pnpm: build",
            "type": "shell",
            "command": "pnpm",
            "args": ["run", "compile"],
            "problemMatcher": "$tsc",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "pnpm: watch",
            "type": "shell",
            "command": "pnpm",
            "args": ["run", "watch"],
            "isBackground": true,
            "problemMatcher": "$tsc-watch"
        },
        {
            "label": "pnpm: test",
            "type": "shell",
            "command": "pnpm",
            "args": ["test"],
            "problemMatcher": "$tsc"
        }
    ]
}
